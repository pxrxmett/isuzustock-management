# ==================================
# Application Settings
# ==================================
NODE_ENV=development
PORT=3000

# ==================================
# Database Configuration
# ==================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_DATABASE=stock_management

# ==================================
# JWT Authentication
# ==================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_32_characters_long_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_characters_long_here
JWT_REFRESH_EXPIRES_IN=30d

# ==================================
# LINE Integration
# ==================================
LINE_CHANNEL_ID=2006746784
LINE_CHANNEL_SECRET=e673f3def0fecc4eeb43aad4460381fa
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_LIFF_ID=2006746784-e1y9NRqn

# ==================================
# Frontend URLs
# ==================================
FRONTEND_URL=http://localhost:4000
ADMIN_URL=http://localhost:8080

# ==================================
# Storage Configuration
# ==================================
# Storage type: 'local' or 's3'
# - local: Store files in ./public/uploads (dev) or /tmp/uploads (Railway)
# - s3: Store files in AWS S3 bucket (recommended for production)
STORAGE_TYPE=local

# API Base URL (for generating file URLs)
API_BASE_URL=http://localhost:3000

# AWS S3 Configuration (only needed if STORAGE_TYPE=s3)
# Uncomment and configure when ready to migrate to S3:
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_CLOUDFRONT_URL=https://xxxxx.cloudfront.net
